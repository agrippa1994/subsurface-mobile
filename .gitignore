# Node
node_modules/
npm-debug.*
yarn-error.*
*.log

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build artifacts (regenerated by expo prebuild)
/ios/
/android/
ios/Pods/
# Local EAS build output (eas build --local).
/build-*.apk
/build-*.aab
/build-*.ipa

# Metro / bundler
.metro-health-check*

# Env / secrets
.env*.local
.env

# macOS
.DS_Store

# TypeScript
*.tsbuildinfo

# ssrf-core: vendored Subsurface core subset + host build output.
# Reproduced by modules/ssrf-core/scripts/vendor-core.mjs; never edit by hand.
modules/ssrf-core/cpp/generated/
modules/ssrf-core/resources/xslt/
modules/ssrf-core/build/
# ssrf-core: libxslt cross-build scratch (sources + per-slice installs).
modules/ssrf-core/ios/vendor/build/.work/
# git-sync: libgit2/libssh2/OpenSSL cross-build scratch.
modules/git-sync/ios/vendor/build/.work/
# ssrf-core: Android libxml2/libxslt cross-build scratch.
modules/ssrf-core/android/vendor/build/.work/
# git-sync: Android libgit2/libssh2/OpenSSL cross-build scratch.
modules/git-sync/android/vendor/build/.work/
# Android module build output (Gradle / CMake).
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/
modules/*/android/.kotlin/

# Android Studio / Gradle local state, and signing keys.
local.properties
.idea/
*.iml
*.jks
*.keystore
